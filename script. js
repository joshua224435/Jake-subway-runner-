const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');

let player = {
  x: 180,
  y: 500,
  width: 40,
  height: 40,
  color: "lime"
};

let lanes = [80, 180, 280];
let obstacles = [];
let speed = 4;
let score = 0;

// Controls
document.addEventListener('keydown', e => {
  if (e.key === "ArrowLeft") {
    player.x = Math.max(player.x - 100, 80);
  } else if (e.key === "ArrowRight") {
    player.x = Math.min(player.x + 100, 280);
  }
});

// Obstacle generator
function createObstacle() {
  let lane = lanes[Math.floor(Math.random() * 3)];
  obstacles.push({ x: lane, y: -50, width: 40, height: 40, color: "red" });
}

setInterval(createObstacle, 1500);

// Game loop
function gameLoop() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);

  // Draw player
  ctx.fillStyle = player.color;
  ctx.fillRect(player.x, player.y, player.width, player.height);

  // Draw obstacles
  for (let i = 0; i < obstacles.length; i++) {
    let obs = obstacles[i];
    obs.y += speed;
    ctx.fillStyle = obs.color;
    ctx.fillRect(obs.x, obs.y, obs.width, obs.height);

    // Collision
    if (
      obs.y + obs.height > player.y &&
      obs.y < player.y + player.height &&
      obs.x === player.x
    ) {
      alert("Game Over! Score: " + score);
      document.location.reload();
    }

    // Score update
    if (obs.y > canvas.height) {
      obstacles.splice(i, 1);
      score++;
    }
  }

  ctx.fillStyle = "#fff";
  ctx.fillText("Score: " + score, 10, 20);

  requestAnimationFrame(gameLoop);
}

gameLoop();
